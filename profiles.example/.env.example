# Copy this folder to profiles/<name>/ and rename to .env
FATHOM_API_KEY=paste-your-fathom-api-key
# Timezone used to stamp each call's date (a 9pm ET call is still "today" in ET)
TIMEZONE=America/New_York
# Optional: LLM. If unset the skill uses the `claude` CLI you are already logged into.
# ANTHROPIC_API_KEY=
# MODEL_TYPE=claude-haiku-4-5-20251001
# MODEL_EXTRACT=claude-sonnet-5
# Google Drive (skip if you only want local files: run with --local-only)
# DRIVE_ROOT_FOLDER_ID=folder-id-from-the-drive-url
